// Hub ADV Internacional - schema de dados
// Postgres (Supabase) em produção e desenvolvimento.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Autenticação ----------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String   @default("")
  title        String   @default("") // "Sr." | "Sra." | "" (tratamento exibido no topo do app)
  passwordHash String
  googleId     String?  @unique // preenchido quando a conta foi criada/vinculada via "Continuar com Google"
  role         String   @default("CLIENT") // ADMIN | CLIENT
  suspended    Boolean  @default(false) // bloqueado pelo painel super-admin, impede login
  suspendedAt  DateTime?
  theme        String   @default("system") // "light" | "dark" | "system" - preferência salva na conta, não só no navegador
  avatarUrl    String   @default("") // foto de perfil como data-URL (base64), sem depender de storage externo
  createdAt    DateTime @default(now())

  invoices        Invoice[]
  feeCalculations FeeCalculation[]
  notifications   Notification[]
  auditLogs       AuditLog[]
  crmClients      CrmClient[]
  whatsappSession WhatsappSession?
  whatsappMessages WhatsappMessage[]
  whatsappStatusNotifications WhatsappStatusNotification[]
  whatsappFunnelMessages WhatsappFunnelMessage[]

  ownedTeam      Team?       @relation("TeamOwner")
  teamMembership TeamMember? @relation("TeamMembership")

  crmDocumentTemplates CrmDocumentTemplate[]
  legalCases           LegalCase[]
  feeContracts         FeeContract[]
  assignedCrmClients   CrmClient[] @relation("CrmClientAssignee")
  followUpRule         FollowUpRule?
  timeEntries          TimeEntry[]
  autoTaskRule         AutoTaskRule?
  pushSubscriptions    PushSubscription[]
  emailCampaigns       EmailCampaign[]
  automationRules      AutomationRule[]
  passwordResetTokens  PasswordResetToken[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String    // código numérico de 6 dígitos, enviado por e-mail
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ---------- Equipe (compartilhamento total de conta entre usuários convidados) ----------

model Team {
  id        String   @id @default(cuid())
  ownerId   String   @unique
  owner     User     @relation("TeamOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  name      String   @default("Equipe padrão")
  createdAt DateTime @default(now())

  members TeamMember[]
  invites TeamInvite[]
}

model TeamMember {
  id              String   @id @default(cuid())
  teamId          String
  team            Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId          String   @unique
  user            User     @relation("TeamMembership", fields: [userId], references: [id], onDelete: Cascade)
  joinedAt        DateTime @default(now())
  canViewFinance  Boolean  @default(true) // dono pode restringir acesso a honorários/faturas por membro

  @@index([teamId])
}

model TeamInvite {
  id         String    @id @default(cuid())
  teamId     String
  team       Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  email      String
  code       String    @unique
  status     String    @default("PENDING") // PENDING | ACCEPTED | REVOKED
  createdAt  DateTime  @default(now())
  acceptedAt DateTime?

  @@index([teamId])
  @@index([email])
}

// Chat interno da equipe (sala única por workspace, entre dono e membros
// convidados) - separado do WhatsApp, que é para conversas com clientes.
model TeamChatMessage {
  id          String   @id @default(cuid())
  teamOwnerId String   // identifica o workspace (mesmo id usado por getWorkspaceOwnerId)
  authorId    String
  authorName  String   @default("")
  recipientId String?  // null = mensagem da equipe (grupo); preenchido = conversa particular 1:1
  text        String
  createdAt   DateTime @default(now())

  @@index([teamOwnerId, createdAt])
  @@index([teamOwnerId, recipientId, authorId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// ---------- Sanções ----------

model SanctionEntry {
  id          String   @id @default(cuid())
  externalId  String   // id na lista de origem (uid do OFAC, referenceNumber da UE/ONU, etc.)
  source      String   // "OFAC" | "EU" | "UN"
  name        String
  aliases     String   @default("") // separados por "; "
  entityType  String   @default("") // Individual | Entity | Vessel | ...
  programs    String   @default("") // programas/jurisdição de sanção, separados por "; "
  countries   String   @default("") // países associados, separados por "; "
  listedDate  String   @default("")
  rawHash     String   // hash do conteúdo normalizado, usado para detectar mudanças
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  active      Boolean  @default(true)

  changeEvents SanctionChangeEvent[]

  @@unique([source, externalId])
  @@index([name])
}

model SanctionChangeEvent {
  id          String   @id @default(cuid())
  entryId     String?
  entry       SanctionEntry? @relation(fields: [entryId], references: [id])
  source      String
  externalId  String
  entryName   String
  changeType  String   // "ADDED" | "REMOVED" | "MODIFIED"
  details     String   @default("") // descrição legível da mudança de jurisdição/programa
  createdAt   DateTime @default(now())
}

model SanctionSyncRun {
  id           String   @id @default(cuid())
  source       String
  status       String   // "SUCCESS" | "ERROR"
  message      String   @default("")
  entriesCount Int      @default(0)
  changesCount Int      @default(0)
  startedAt    DateTime @default(now())
  finishedAt   DateTime?
}

// ---------- Legislação e Regulamentos dos EUA (acoplado ao módulo de Sanções) ----------

model ComplianceEvent {
  id            String   @id @default(cuid())
  externalId    String   // document_number (Federal Register), bill number (Congress.gov), packageId (GovInfo)
  eventType     String   // "REGULATION" | "LEGISLATION"
  source        String   // "FEDERAL_REGISTER" | "CONGRESS_GOV" | "GOVINFO"
  issuingBody   String   @default("")
  title         String
  summary       String   @default("")
  severity      String   @default("MEDIUM") // "LOW" | "MEDIUM" | "HIGH" | "CRITICAL"
  publishedDate DateTime
  sourceUrl     String
  rawHash       String
  firstSeenAt   DateTime @default(now())
  lastSeenAt    DateTime @default(now())
  active        Boolean  @default(true)

  changeEvents  ComplianceChangeEvent[]

  @@unique([source, externalId])
  @@index([title])
  @@index([publishedDate])
}

model ComplianceChangeEvent {
  id          String   @id @default(cuid())
  eventId     String?
  event       ComplianceEvent? @relation(fields: [eventId], references: [id])
  source      String
  externalId  String
  title       String
  changeType  String   // "ADDED" | "MODIFIED"
  details     String   @default("")
  createdAt   DateTime @default(now())
}

model ComplianceSyncRun {
  id           String   @id @default(cuid())
  source       String
  status       String   // "SUCCESS" | "ERROR" | "SKIPPED" (SKIPPED = chave de API não configurada)
  message      String   @default("")
  entriesCount Int      @default(0)
  changesCount Int      @default(0)
  startedAt    DateTime @default(now())
  finishedAt   DateTime?
}

// ---------- Notificações (central estilo e-mail) ----------

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // "SANCTIONS" | "FX" | "INVOICE" | "MEETING" | "SYSTEM"
  sender    String   @default("Monitor de Compliance")
  subject   String
  body      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

// ---------- Auditoria ----------

model AuditLog {
  id           String   @id @default(cuid())
  userId       String?  // null = ação de sistema (ex.: sincronização automática em segundo plano)
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  actor        String   @default("analista")
  action       String   // "SEARCH" | "VIEW" | "EXPORT" | "SYNC"
  module       String   // "sancoes" | "honorarios" | "faturas" | "reunioes"
  query        String   @default("")
  resultSummary String  @default("")
  createdAt    DateTime @default(now())

  @@index([userId])
}

// Log de auditoria exclusivo do painel super-admin (/superadmin) - separado do
// AuditLog de clientes para não misturar ação administrativa com ação de conta.
model SuperadminAuditLog {
  id           String   @id @default(cuid())
  action       String   // LOGIN | SUSPEND | UNSUSPEND | DELETE_ACCOUNT
  targetEmail  String   @default("")
  targetUserId String   @default("")
  details      String   @default("")
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

// ---------- Honorários / Câmbio ----------

model FeeCalculation {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  description    String   @default("")
  baseAmount     Float
  baseCurrency   String
  targetCurrency String
  rate           Float
  convertedAmount Float
  rateDate       String
  jurisdictionCountry String @default("")
  jurisdictionState   String @default("")
  createdAt      DateTime @default(now())

  invoices Invoice[]

  @@index([userId])
}

// ---------- Faturas ----------

model Invoice {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  number        String
  issuerName    String
  issuerTaxId   String   @default("")
  issuerAddress String   @default("")
  clientName    String
  clientTaxId   String   @default("")
  clientAddress String   @default("")
  currency      String
  exchangeRate  Float    @default(1)
  taxRate       Float    @default(0)
  notes         String   @default("")
  status        String   @default("DRAFT") // DRAFT | ISSUED | PAID
  issueDate     String
  dueDate       String   @default("")
  feeCalculationId String?
  feeCalculation   FeeCalculation? @relation(fields: [feeCalculationId], references: [id])
  clientId      String? // vínculo opcional ao cliente do CRM
  crmClient     CrmClient? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  caseId        String? // vínculo opcional ao processo
  legalCase     LegalCase? @relation(fields: [caseId], references: [id], onDelete: SetNull)
  installmentId String? // origem: gerada a partir de uma parcela de contrato de honorários
  installment   FeeInstallment? @relation(fields: [installmentId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())

  items InvoiceLineItem[]

  @@unique([userId, number])
  @@index([userId])
}

model InvoiceLineItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Float   @default(1)
  unitPrice   Float
}

// ---------- CRM de clientes ----------

model CrmClient {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName       String
  documentType   String   @default("CPF") // CPF | CNPJ
  documentNumber String   @default("") // apenas dígitos
  legalArea      String   @default("Outro")
  companyName    String   @default("")
  city           String   @default("")
  phone          String   @default("") // apenas dígitos, com DDI (ex.: 5511999999999)
  email          String   @default("")
  status         String   @default("CONTACTED") // CONTACTED | INITIALIZED | IN_PROGRESS | FINISHED
  parentClientId String? // referência ao cliente original quando este foi criado via "Duplicar cadastro"
  assigneeId     String? // advogado/responsável da equipe atribuído a este cliente
  assignee       User?    @relation("CrmClientAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  lastFollowUpAlertAt DateTime? // evita repetir o alerta de "funil parado" enquanto o status não mudar
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  statusHistory     CrmStatusHistory[]
  whatsappMessages  WhatsappMessage[]
  notes             CrmNote[]
  tasks             CrmTask[]
  meetings          CrmMeeting[]
  documents         CrmDocument[]
  activities        CrmActivity[]
  legalCases        LegalCase[]
  feeContracts      FeeContract[]
  invoices          Invoice[]
  assignmentHistory CrmAssignmentHistory[]

  @@index([userId])
  @@index([userId, status])
  @@index([userId, phone])
  @@index([assigneeId])
}

model EmailCampaign {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject         String
  body            String
  totalRecipients Int      @default(0)
  sentCount       Int      @default(0)
  failedCount     Int      @default(0)
  status          String   @default("SENDING") // SENDING | SENT | ERROR
  message         String   @default("") // erro geral, se houver (ex.: chave não configurada)
  createdAt       DateTime @default(now())

  recipients EmailCampaignRecipient[]

  @@index([userId, createdAt])
}

model EmailCampaignRecipient {
  id         String        @id @default(cuid())
  campaignId String
  campaign   EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  clientId   String?
  email      String
  status     String        @default("PENDING") // PENDING | SENT | FAILED
  error      String        @default("")

  @@index([campaignId])
}

model AutomationRule {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String   @default("")
  enabled       Boolean  @default(true)
  triggerType   String   // CLIENT_CREATED | CLIENT_STATUS_CHANGED
  triggerStatus String   @default("") // status-alvo quando triggerType = CLIENT_STATUS_CHANGED ("" = qualquer status)
  actionType    String   // CREATE_TASK | SEND_NOTIFICATION | SEND_WHATSAPP
  actionText    String   @default("") // título da tarefa, ou texto da notificação/whatsapp
  actionDays    Int      @default(1) // usado só em CREATE_TASK (prazo em dias)
  createdAt     DateTime @default(now())

  @@index([userId, triggerType])
}

model CrmAssignmentHistory {
  id           String    @id @default(cuid())
  clientId     String
  client       CrmClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  assigneeId   String?
  assigneeName String    @default("") // "" = não atribuído (removido)
  assignedAt   DateTime  @default(now())

  @@index([clientId])
}

// Regra de follow-up automático do funil: "se o cliente não mudar de status em N
// dias, notificar o responsável". Uma regra por workspace (dono da conta).
model FollowUpRule {
  id      String  @id @default(cuid())
  userId  String  @unique
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  days    Int     @default(7)
  enabled Boolean @default(false)
}

// Automação "novo cliente cadastrado -> cria tarefa de primeiro contato".
model AutoTaskRule {
  id            String  @id @default(cuid())
  userId        String  @unique
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  enabled       Boolean @default(false)
  taskTitle     String  @default("Primeiro contato")
  daysUntilDue  Int     @default(1)
}

// ---------- Processos/Casos ----------
// Consulta automática via API de tribunais (ex.: DataJud/CNJ) fica preparada
// para o futuro: LegalCaseMovement.source distingue MANUAL de DATAJUD, e
// LegalCase.caseNumber guarda o número CNJ para quando a integração existir.

model LegalCase {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId   String
  client     CrmClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  caseNumber String    @default("") // número CNJ do processo, se houver
  title      String
  court      String    @default("") // tribunal/vara (texto livre, exibição)
  tribunalAlias String @default("") // alias do tribunal na API DataJud (ex.: api_publica_tjsp), para consulta automática
  status     String    @default("ACTIVE") // ACTIVE | CLOSED | ARCHIVED
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  closedAt   DateTime?

  movements    LegalCaseMovement[]
  deadlines    LegalCaseDeadline[]
  feeContracts FeeContract[]
  invoices     Invoice[]
  timeEntries  TimeEntry[]

  @@index([userId])
  @@index([userId, status])
  @@index([clientId])
}

// Horas trabalhadas por processo - útil para cobrança por hora ou controle de
// produtividade da equipe.
model TimeEntry {
  id          String    @id @default(cuid())
  caseId      String
  case        LegalCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  description String    @default("")
  hours       Float
  hourlyRate  Float?
  date        DateTime  @default(now())
  createdAt   DateTime  @default(now())

  @@index([caseId])
  @@index([userId])
}

model LegalCaseMovement {
  id          String    @id @default(cuid())
  caseId      String
  case        LegalCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  type        String    @default("MOVEMENT") // MOVEMENT | DECISION | DISPATCH
  description String
  occurredAt  DateTime  @default(now())
  source      String    @default("MANUAL") // MANUAL | DATAJUD
  createdAt   DateTime  @default(now())

  @@index([caseId])
}

model LegalCaseDeadline {
  id         String    @id @default(cuid())
  caseId     String
  case       LegalCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  title      String
  dueDate    DateTime
  alertDays  String    @default("5,2,1") // dias antes do vencimento para alertar, separados por vírgula
  alertsSent String    @default("[]") // JSON array dos limiares já notificados, evita duplicar alerta
  status     String    @default("PENDING") // PENDING | DONE | EXPIRED
  createdAt  DateTime  @default(now())

  @@index([caseId])
  @@index([status, dueDate])
}

// ---------- Financeiro: contratos de honorários e parcelas ----------

model FeeContract {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId    String
  client      CrmClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  caseId      String?
  case        LegalCase? @relation(fields: [caseId], references: [id], onDelete: SetNull)
  description String    @default("")
  totalAmount Float
  currency    String    @default("BRL")
  status      String    @default("ACTIVE") // ACTIVE | CANCELLED | COMPLETED
  createdAt   DateTime  @default(now())

  installments FeeInstallment[]

  @@index([userId])
  @@index([clientId])
}

model FeeInstallment {
  id          String      @id @default(cuid())
  contractId  String
  contract    FeeContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  number      Int
  amount      Float
  dueDate     DateTime
  status      String      @default("PENDING") // PENDING | PAID | OVERDUE | CANCELLED
  paidAt      DateTime?
  paidAmount  Float?
  createdAt   DateTime    @default(now())

  invoices Invoice[]

  @@index([contractId])
  @@index([status, dueDate])
}

model CrmStatusHistory {
  id        String    @id @default(cuid())
  clientId  String
  client    CrmClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  status    String
  changedAt DateTime  @default(now())

  @@index([clientId])
}

// Linha do tempo unificada de ações rápidas do cliente (requisito geral: toda
// ação deve gerar um registro de quem fez o quê e quando).
model CrmActivity {
  id          String    @id @default(cuid())
  clientId    String
  client      CrmClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type        String    // STATUS_CHANGE | NOTE | TASK | MEETING | DOCUMENT | WHATSAPP | DUPLICATE | CREATED
  description String
  actor       String    @default("")
  createdAt   DateTime  @default(now())

  @@index([clientId])
}

model CrmNote {
  id        String    @id @default(cuid())
  clientId  String
  client    CrmClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  authorName String   @default("")
  text      String
  createdAt DateTime  @default(now())

  @@index([clientId])
}

model CrmTask {
  id          String    @id @default(cuid())
  clientId    String
  client      CrmClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title       String
  assignee    String    @default("") // nome/e-mail livre do responsável
  dueDate     DateTime?
  status      String    @default("PENDING") // PENDING | DONE
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([clientId])
  @@index([clientId, status])
}

model CrmMeeting {
  id           String    @id @default(cuid())
  clientId     String
  client       CrmClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title        String
  scheduledFor DateTime
  notes        String    @default("")
  createdAt    DateTime  @default(now())

  @@index([clientId])
}

// Modelos de documento (contrato, procuração etc.) com placeholders
// {{fullName}}, {{documentNumber}}, {{city}}... preenchidos automaticamente.
model CrmDocumentTemplate {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  createdAt DateTime @default(now())

  documents CrmDocument[]

  @@index([userId])
}

model CrmDocument {
  id           String               @id @default(cuid())
  clientId     String
  client       CrmClient            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  templateId   String?
  template     CrmDocumentTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  title        String
  content      String
  createdBy    String   @default("") // nome de quem gerou, exibido no fluxo de aprovação
  status       String   @default("APPROVED") // PENDING_APPROVAL | APPROVED | SENT
  approvedAt   DateTime?
  sentAt       DateTime?
  createdAt    DateTime             @default(now())

  @@index([clientId])
}

// ---------- Integração com WhatsApp (conexão não-oficial via QR Code) ----------

model WhatsappSession {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status          String    @default("DISCONNECTED") // DISCONNECTED | CONNECTING | CONNECTED
  qrCode          String    @default("") // data URL base64 do QR atual, válido enquanto CONNECTING
  phoneNumber     String    @default("")
  lastConnectedAt DateTime?
  lastError       String    @default("")
  authState       String    @default("") // credenciais Baileys serializadas (JSON), permite reconectar sem novo QR
  updatedAt       DateTime  @updatedAt
}

model WhatsappMessage {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  crmClientId  String?
  crmClient    CrmClient? @relation(fields: [crmClientId], references: [id], onDelete: SetNull)
  phone        String
  direction    String    // IN | OUT
  body         String
  source       String    @default("BOT") // BOT | AGENT | CLIENT (quem originou uma msg OUT, ou CLIENT p/ IN)
  audioUrl     String    @default("") // se preenchido, mensagem de áudio (ElevenLabs) em vez de texto
  status       String    @default("RECEIVED") // RECEIVED | QUEUED | SENT | FAILED
  scheduledFor DateTime?
  sentAt       DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([crmClientId])
  @@index([userId, status])
}

model WhatsappConversationState {
  id          String   @id @default(cuid())
  userId      String
  phone       String
  crmClientId String?
  step        String   @default("MENU") // MENU | COLLECT_NAME | COLLECT_AREA | COLLECT_CITY | DONE | HUMAN_HANDOFF
  attempts    Int      @default(0)
  data        String   @default("{}")
  updatedAt   DateTime @updatedAt

  @@unique([userId, phone])
}

model WhatsappCommand {
  id        String   @id @default(cuid())
  userId    String
  type      String   // DISCONNECT | NEW_QR
  status    String   @default("PENDING") // PENDING | DONE
  createdAt DateTime @default(now())

  @@index([userId, status])
}

// Textos do funil de atendimento automático - editáveis pelo usuário. Chaves usadas
// pelo worker (com um texto padrão de fallback caso a conta não tenha customizado):
// WELCOME_MENU, MENU_INVALID, HANDOFF_ACOMPANHAR, HANDOFF_ADVOGADO, HANDOFF_ATTEMPTS,
// COLLECT_NAME, COLLECT_AREA, COLLECT_CITY, DONE.
model WhatsappFunnelMessage {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  key    String
  text   String

  @@unique([userId, key])
}

model WhatsappErrorLog {
  id        String   @id @default(cuid())
  userId    String
  message   String
  createdAt DateTime @default(now())

  @@index([userId])
}

model WhatsappStatusNotification {
  id      String  @id @default(cuid())
  userId  String
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  status  String  // CONTACTED | INITIALIZED | IN_PROGRESS | FINISHED
  message String  @default("")
  enabled Boolean @default(false)

  @@unique([userId, status])
}
